    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.1",
    "dotenv": "17.4.2",
    "express": "4.22.3",
