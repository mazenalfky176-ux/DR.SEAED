# Server-side only. Never prefix a secret with VITE_. Set these as Cloudflare Pages secrets.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Exact UUID of the clinic owner account created in Supabase Authentication.
ADMIN_USER_ID=
# Production origin, e.g. https://clinic.example.com (not required for localhost).
PUBLIC_SITE_URL=
PORT=3000
