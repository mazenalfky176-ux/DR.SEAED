# Server-side only. Never prefix a secret with VITE_. Set these as Cloudflare Pages secrets.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Stable identifier used for the server-side admin session.
ADMIN_USER_ID=
# Admin login credentials. Set both as server-side secrets in Cloudflare.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Production origin, e.g. https://clinic.example.com (not required for localhost).
PUBLIC_SITE_URL=
PORT=3000
